# CampaignX Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (required for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# CampaignX Live API
CAMPAIGNX_API_BASE_URL=https://campaignx.inxiteout.ai/api/v1
CAMPAIGNX_API_KEY=your_campaignx_api_key_here

# Langfuse Observability (optional but recommended)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Set to "true" to use dummy customers instead of live API
MOCK_MODE=false
