# ============================================================
# CampaignX — Environment Configuration
# ============================================================
# Copy this file:  cp .env.example .env
# Then fill in your API keys below.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Groq API key (required). Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model — controls quality vs rate-limit tradeoff
# llama-3.1-8b-instant   → higher rate limits, good for most tasks (default)
# llama-3.3-70b-versatile → best quality, lower rate limits (use for final demo)
GROQ_MODEL=llama-3.1-8b-instant

# ── CampaignX Live API ───────────────────────────────────────
# Base URL for the campaign API (no trailing slash)
CAMPAIGNX_API_BASE_URL=https://campaignx.inxiteout.ai
# Your team API key from signup
CAMPAIGNX_API_KEY=your_campaignx_api_key_here

# ── Langfuse Observability (optional) ────────────────────────
# Sign up at https://cloud.langfuse.com for free tracing
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Runtime Modes ────────────────────────────────────────────
# MOCK_MODE=true  → uses 50 dummy customers (no API calls)
# MOCK_MODE=false → uses real/cached customer data
MOCK_MODE=false

# USE_CACHE=true  → loads customers from local cache file (0 API calls)
# USE_CACHE=false → fetches fresh from live API (1 API call)
USE_CACHE=true

# ── Local Testing (Prism Mock Server) ────────────────────────
# To test without burning API quota, start Prism:
#   npx @stoplight/prism-cli mock campaignx_api.json
# Then uncomment the line below and comment out the live URL above:
# CAMPAIGNX_API_BASE_URL=http://localhost:4010
